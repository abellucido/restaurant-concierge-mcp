# Copy to .env to override the defaults. .env is ignored by git.

# Any Ollama model with tool-calling support
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# Set to true to get a temporary public gradio.live link
GRADIO_SHARE=false

# Optional: point the MCP server at a different dataset
# RESTAURANTS_PATH=data/restaurants.json
